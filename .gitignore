# Virtual environment
.venv/

# Byte-compiled and distributed files
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Downloaded MediaPipe model bundle (large, regenerated by setup)
models/*.task

# 3D CAD assets - tracked separately, not in this repo
assets/models/*.stl
assets/models/*.obj

# Generated runtime output
output/*
!output/.gitkeep

# Editor / OS metadata
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
*_probe.py
scratch/
